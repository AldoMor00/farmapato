# Copiar a `.env` (ignorado por git) antes de `docker compose up -d`.
#
# Estas credenciales son de una base local desechable con datos sintéticos, pero
# el `.env` real no se versiona nunca: la misma disciplina que aplica a Azure.

POSTGRES_USER=farmapato
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=farmapato

# Puerto en el host. 5433 evita el choque con un Postgres nativo en 5432.
POSTGRES_PORT=5433

# Host al que se conecta el paso de carga. En CI el service container también
# responde en localhost; esto sólo cambiaría si el loader corriera en un contenedor.
POSTGRES_HOST=localhost

# Landing zone en ADLS Gen2. Van con valores reales porque no son secretos: la
# cuenta se creó sin shared key, así que no existe una llave que filtrar. El
# acceso se otorga por RBAC a una identidad (`az login` en local, OIDC en CI).
AZURE_STORAGE_ACCOUNT=stfarmapato
AZURE_STORAGE_CONTAINER=landing
